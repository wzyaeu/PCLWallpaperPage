<local:MyCard Margin="0,5"
              UseAnimation="False">
    <Grid>
        <Border   CornerRadius="4">
            <Border.Background>
                <ImageBrush
                    ImageSource="{img}"
                    Stretch="UniformToFill"
                    AlignmentX="Center"
                    AlignmentY="Center"/>
            </Border.Background>
            <Border.Effect>
                <BlurEffect Radius="10"
                            RenderingBias="Performance"/>
            </Border.Effect>
        </Border>
        <StackPanel>
            <local:MyImage Margin="3"
                           VerticalAlignment="Top"
                           Source="{img}"/>
            <Grid VerticalAlignment="Bottom"
                  Margin="3,0,3,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0"
                      Margin="10,0">
                    <Border
                        CornerRadius="0,0,4,4"
                        Background="#000000"
                        Opacity="0.5"
                        Margin="-5">
                        <Border.Effect>
                            <BlurEffect Radius="10"
                                        RenderingBias="Performance"/>
                        </Border.Effect>
                    </Border>
                    <WrapPanel
                        Margin="5">
                        <StackPanel Margin="0,0,5,0">
                            <Border
                                Background="{DynamicResource ColorBrush7}"
                                Margin="0,0,2,0"
                                CornerRadius="5"
                                HorizontalAlignment="Left">
                                <TextBlock TextWrapping="Wrap"
                                           Margin="4,2"
                                           FontSize="16"
                                           Foreground="{DynamicResource ColorBrush1}"
                                           Text="{date} {sub-title}"/>
                            </Border>
                            <TextBlock TextWrapping="Wrap"
                                       FontSize="40"
                                       Foreground="{DynamicResource ColorBrush8}"
                                       Text="{title}"/>
                            <TextBlock TextWrapping="Wrap"
                                       FontSize="16"
                                       Margin="4,0"
                                       Grid.Column="1"
                                       Foreground="{DynamicResource ColorBrush8}"
                                       Text="{desc}"/>
                        </StackPanel>
                        <Grid Margin="10,15,10,10"
                              VerticalAlignment="Top">
                            <Border
                                CornerRadius="4"
                                Background="{DynamicResource ColorBrush4}"
                                Opacity="0.5"
                                Margin="-5">
                                <Border.Effect>
                                    <BlurEffect Radius="10"
                                                RenderingBias="Performance"/>
                                </Border.Effect>
                            </Border>
                            <Border
                                CornerRadius="4"
                                Background="{DynamicResource ColorBrush8}"
                                Opacity="0.3"
                                Margin="-5">
                                <Border.Effect>
                                    <BlurEffect Radius="10"
                                                RenderingBias="Performance"/>
                                </Border.Effect>
                            </Border>
                            <StackPanel
                                Orientation="Horizontal"
                                Margin="0,5">
                                <local:MyButton
                                    Margin="5,0"
                                    Padding="10,0,10,0"
                                    Height="35"
                                    Text="下载图片 (1080P)"
                                    ColorType="Highlight"
                                    EventType="下载文件"
                                    EventData="{img}|{download_name}"/>
                                <local:MyButton
                                    Margin="5,0"
                                    Padding="10,0,10,0"
                                    Height="35"
                                    Text="下载图片 (4K)"
                                    EventType="下载文件"
                                    EventData="{img_4k}|{download_name}"/>
                            </StackPanel>
                        </Grid>
                    </WrapPanel>
                </Grid>
            </Grid>
        </StackPanel>
    </Grid>
</local:MyCard>